{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-instance2"
		},
		"AzureDatabricksconnection_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricksconnection'"
		},
		"LocalMySQL_LinkedService_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LocalMySQL_LinkedService'"
		},
		"ls_adls_gen2_bigdata_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_gen2_bigdata'"
		},
		"LocalMySQL_LinkedService_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"LocalMySQL_LinkedService_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "healthcare_db"
		},
		"LocalMySQL_LinkedService_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"ls_adls_gen2_bigdata_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://bigdatastoragedata.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-instance2_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDatabricksconnection_accessToken": {
						"value": "[parameters('AzureDatabricksconnection_accessToken')]"
					},
					"ls_adls_gen2_bigdata_accountKey": {
						"value": "[parameters('ls_adls_gen2_bigdata_accountKey')]"
					},
					"LocalMySQL_LinkedService_password": {
						"value": "[parameters('LocalMySQL_LinkedService_password')]"
					},
					"ls_adls_gen2_bigdata_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_gen2_bigdata_properties_typeProperties_url')]"
					},
					"LocalMySQL_LinkedService_properties_typeProperties_server": {
						"value": "[parameters('LocalMySQL_LinkedService_properties_typeProperties_server')]"
					},
					"LocalMySQL_LinkedService_properties_typeProperties_database": {
						"value": "[parameters('LocalMySQL_LinkedService_properties_typeProperties_database')]"
					},
					"LocalMySQL_LinkedService_properties_typeProperties_username": {
						"value": "[parameters('LocalMySQL_LinkedService_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}